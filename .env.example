# =============================================================================
# Save Shop Mobile & Web App (Expo) Environment Variables Example
# =============================================================================

# Staging Environment
# EXPO_PUBLIC_API_URL=https://stg.mysaveshop.online
# EXPO_PUBLIC_PROD_API_URL=https://stg.mysaveshop.online

# Production Environment
# EXPO_PUBLIC_API_URL=https://mysaveshop.online
# EXPO_PUBLIC_PROD_API_URL=https://mysaveshop.online

# Active Deployed Backend API URL
EXPO_PUBLIC_API_URL=https://stg.mysaveshop.online
EXPO_PUBLIC_PROD_API_URL=https://stg.mysaveshop.online

# Local Development Backend API URL (use your PC's LAN IP for physical mobile devices)
EXPO_PUBLIC_DEV_API_URL=http://192.168.29.252:8000

# Force production mode during local development (leave false so local connects to local backend & local db)
EXPO_PUBLIC_FORCE_PROD=false

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=898498745806-g40fimuhq99o7aohltn4qqinpvog31d5.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=898498745806-gnrm36ifk3qoek9et2ej5o6ajrrc1bbm.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
