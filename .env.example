# =============================================================================
# Save Shop Mobile & Web App (Expo) Environment Variables Example
# =============================================================================

# Production Deployed Backend API URL (used automatically when deployed or in release builds)
EXPO_PUBLIC_PROD_API_URL=https://chamber-golf-guardian-thumbnails.trycloudflare.com
EXPO_PUBLIC_API_URL=https://chamber-golf-guardian-thumbnails.trycloudflare.com

# Local Development Backend API URL (used automatically during local development)
EXPO_PUBLIC_DEV_API_URL=http://localhost:8000

# Force production mode during local development (leave false so local connects to local backend & local db)
EXPO_PUBLIC_FORCE_PROD=false

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Used for Web and Expo Go authentication
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Android Client ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Optional Native Client IDs (for standalone iOS builds)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
